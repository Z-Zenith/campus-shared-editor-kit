{
  "name": "@campus/shared-editor-kit",
  "version": "0.2.0",
  "description": "Shared Editor Kit (SEK) — public TypeScript interface consumed by Teacher Web App (TWA) and Student Desktop App (SDA). See docs/Campus platform architecture.md Section 3 (SEK-01..05) and docs/campus-platform-work-division.md Wave 1.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./code-editor": {
      "types": "./dist/code-editor/index.d.ts",
      "default": "./dist/code-editor/index.js"
    },
    "./document-viewer": {
      "types": "./dist/document-viewer/index.d.ts",
      "default": "./dist/document-viewer/index.js"
    },
    "./notes": {
      "types": "./dist/notes/index.d.ts",
      "default": "./dist/notes/index.js"
    },
    "./image-search": {
      "types": "./dist/image-search/index.d.ts",
      "default": "./dist/image-search/index.js"
    },
    "./types": {
      "types": "./dist/types/common.d.ts",
      "default": "./dist/types/common.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.base.json",
    "build:host": "node scripts/build-host.mjs",
    "test": "tsc && node --test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.28.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "campus-platform",
    "sek",
    "shared-editor-kit",
    "twa",
    "sda"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-font-family": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "monaco-editor": "^0.56.0"
  },
  "overrides": {
    "dompurify": "^3.4.12"
  }
}
